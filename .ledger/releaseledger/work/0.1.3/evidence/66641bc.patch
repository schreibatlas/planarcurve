+            for at, rate in zip(positions, rates[1:-1], strict=True)
+        )
+        return HeadingRateProfile(
+            start_rate_deg_per_u=float(rates[0]),
+            changes=changes,
+            end_rate_deg_per_u=float(rates[-1]),
+            interpolation=self.interpolation,
+        )
