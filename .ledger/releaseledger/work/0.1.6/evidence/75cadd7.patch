+                len(existing_changes),
+                tuple(steps),
+                "numerical_failure",
+            )
+        locations = _residual_insertion_candidates(
+            signal,
+            grid,
+            existing_changes,
+            min_spacing=base_options.min_change_spacing,
+            limit=refinement_options.candidate_insertions,
+        )
