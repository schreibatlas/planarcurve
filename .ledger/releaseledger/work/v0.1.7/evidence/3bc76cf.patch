+    source: ArrayLike,
+    *,
+    bounds: SimilarityFitBounds,
+    weights: ArrayLike | None = None,
+) -> Similarity2D:
+    """Fit a bounded similarity and return only its transform."""
+    return fit_bounded_similarity(target, source, bounds=bounds, weights=weights).transform
